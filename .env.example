# Required pooled connection for the database-backed API (Neon PostgreSQL)
DATABASE_URL="postgresql://<user>:<password>@<endpoint>/<database>?sslmode=require"
# Required direct, unpooled URL for Prisma schema commands and seeding
DIRECT_URL="postgresql://<user>:<password>@<endpoint>/<database>?sslmode=require"
APP_BASE_URL="http://localhost:5173"
API_PORT=4000
ADMIN_BOOTSTRAP_EMAIL=""
ADMIN_BOOTSTRAP_PASSWORD=""
ADMIN_NOTIFICATION_EMAIL=""

# Optional transactional email (booking remains saved without a provider)
EMAIL_PROVIDER_API_KEY=""
EMAIL_FROM=""

# Optional private object storage
STORAGE_ENDPOINT=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# Payments intentionally stay disabled until all values and webhook URLs are configured
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
